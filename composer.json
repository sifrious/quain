{
    "name": "quain/core",
    "description": "Portable capability catalogue: versioned manifests, vocabulary references, skill/agent reads, and remote source inspection.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/yaml": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Quain\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quain\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
